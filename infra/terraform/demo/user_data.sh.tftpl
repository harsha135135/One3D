#!/bin/bash
# First boot of the demo instance: Docker, the Compose plugin (checksum
# verified), 1 GiB of swap as a safety margin, and the application directory.
# The application itself arrives later through deploy.sh (SSM Run Command).
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

plugin=/usr/libexec/docker/cli-plugins/docker-compose
base=https://github.com/docker/compose/releases/download/${compose_version}
mkdir -p "$(dirname "$plugin")"
curl -fsSL -o /tmp/docker-compose "$base/docker-compose-linux-x86_64"
curl -fsSL -o /tmp/docker-compose.sha256 "$base/docker-compose-linux-x86_64.sha256"
echo "$(cut -d' ' -f1 /tmp/docker-compose.sha256)  /tmp/docker-compose" | sha256sum -c -
install -m 0755 /tmp/docker-compose "$plugin"

if [ ! -f /swapfile ]; then
  fallocate -l 1G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

install -d -m 0700 /opt/one3d
install -d -m 0755 /opt/one3d/app
echo "${region}" > /opt/one3d/region
